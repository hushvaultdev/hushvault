{
  "name": "@hushvault/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "deploy:dry-run": "wrangler deploy --dry-run --env staging --outdir .wrangler/dry-run",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "db:migrations:list:staging": "wrangler d1 migrations list DB --remote --env staging",
    "db:migrations:list:production": "wrangler d1 migrations list DB --remote --env production"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "@hono/zod-validator": "^0.4.0",
    "zod": "^3.24.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250322.0",
    "drizzle-kit": "^0.30.0",
    "wrangler": "4.92.0",
    "typescript": "^5.7.0"
  }
}
