{
  "name": "@hushvault/admin",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "next lint",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "test": "vitest run",
    "verify": "pnpm run type-check && pnpm run lint && pnpm run test",
    "deploy:dev": "opennextjs-cloudflare deploy --env dev",
    "deploy:production": "opennextjs-cloudflare deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hushvault/shared": "workspace:*",
    "@hushvault/web-kit": "workspace:*",
    "@opennextjs/cloudflare": "1.20.8",
    "next": "15.5.27",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
