# Base URL of the HushVault API the dashboard talks to.
# Local wrangler dev default is http://127.0.0.1:8787
# Copy to .env.local and adjust as needed.
#
# NEXT_PUBLIC_* values are inlined at BUILD time (also in the Cloudflare deploy).
# For deploys, set the GitHub variable NEXT_PUBLIC_API_URL per environment.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
